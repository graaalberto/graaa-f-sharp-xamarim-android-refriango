<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<RadioGroup
    android:gravity="center"
    android:layout_width="match_parent"
    android:id = "@+id/radg1"
    android:orientation="horizontal"
    android:layout_height="wrap_content">
    <RadioButton
        android:text="L1"
        android:textSize="10pt"
        android:textColor="@android:color/holo_red_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rad1" />
    <RadioButton
        android:text="L2"
        android:textSize="10pt"
        android:textColor="@android:color/holo_red_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rad2" />
     <RadioButton
        android:text="L3"
        android:textSize="10pt"
        android:textColor="@android:color/holo_red_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rad3" />
     <RadioButton
        android:text="L4"
        android:textSize="10pt"
        android:textColor="@android:color/holo_red_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rad4" />
     <RadioButton
        android:text="L5"
        android:textSize="10pt"
        android:textColor="@android:color/holo_red_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rad5" />
     <RadioButton
        android:text="L9"
        android:textSize="10pt"
        android:textColor="@android:color/holo_red_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rad9" />
</RadioGroup>

    <LinearLayout
        android:orientation="vertical"
        android:padding="20px"
        android:layout_gravity="center"
        android:layout_marginBottom="40px"
        android:background="@drawable/blocostyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:text="Contador de Garrafas"
            android:layout_gravity="center"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40px"
            android:id="@+id/textView1" />

        <EditText
            android:inputType="number"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18pt"
            android:id="@+id/editText1" />


        <Button
            android:id="@+id/myButton"
            android:layout_marginTop="20px"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bordas"
            android:textColor="@android:color/white"
            android:textSize="6pt"
            android:text="Calcular" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="10px"
        android:layout_gravity="center"
        android:layout_marginBottom="100px"
        android:background="@android:color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:text="Caixas por Hora:"
            android:background="@drawable/bordas"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView2" />
        <TextView
            android:text="Caixas Total:"
            android:background="@drawable/bordas"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView3" />
        <TextView
            android:text="Tempo perdido:"
            android:background="@drawable/bordas"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView4" />
        <TextView
            android:text="Perdido Total:"
            android:background="@drawable/bordas"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView5" />
        <TextView
            android:text="% Hora:"
            android:background="@drawable/bordas"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView6" />
        <TextView
            android:text="% Total:"
            android:background="@drawable/bordas"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView7" />
        <TextView
            android:text="Palete:"
            android:background="@drawable/bordas"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView8" />

        <SlidingDrawer
            android:content="@+id/content"
            android:handle="@+id/handle"
            android:minWidth="25px"
            android:minHeight="25px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/slidingDrawer1">
            <Button
                android:id="@+id/handle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Graça Alberto" />
            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <EditText
                   android:inputType="text"
                   android:layout_gravity="center"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:textSize="14pt"
                   android:id="@+id/edit1" />
            </LinearLayout>
        </SlidingDrawer>
    </LinearLayout>
</LinearLayout>


